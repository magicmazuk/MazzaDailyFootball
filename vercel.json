{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "rewrites": [
    {
      "source": "/api/espn/(.*)",
      "destination": "/api/espn?_p=/$1"
    },
    {
      "source": "/api/wosfl/(.*)",
      "destination": "/api/wosfl?_p=/$1"
    },
    {
      "source": "/api/iplayer/(.*)",
      "destination": "/api/iplayer?_p=/$1"
    },
    {
      "source": "/api/dossier/(.*)",
      "destination": "/api/dossier?_p=/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
